@model IReadOnlyList<HospitalAppointment.Application.DTOs.Branch.BranchDto>
@{
    ViewData["Title"] = "Şube Yönetimi";
    var hospitalId = (Guid)ViewBag.HospitalId;
    var hospitalName = (string)(ViewBag.HospitalName ?? "");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-code-branch me-2 text-primary"></i>Şubeler</h2>
        <small class="text-muted">@hospitalName</small>
    </div>
    <a asp-action="Create" asp-route-hospitalId="@hospitalId" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Yeni Şube
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>Bu hastaneye ait şube bulunamadı.
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-primary">
                        <tr>
                            <th>Şube Adı</th>
                            <th>Adres</th>
                            <th>Telefon</th>
                            <th>Bölüm Sayısı</th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var branch in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@branch.Name</td>
                                <td><small>@branch.FullAddress</small></td>
                                <td>@branch.PhoneNumber</td>
                                <td><span class="badge bg-primary">@branch.DepartmentCount bölüm</span></td>
                                <td>
                                    <span class="badge @(branch.IsActive ? "bg-success" : "bg-danger")">
                                        @(branch.IsActive ? "Aktif" : "Pasif")
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@branch.Id"
                                       class="btn btn-sm btn-outline-primary me-1">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-controller="Department" asp-action="Index" asp-route-branchId="@branch.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="fas fa-th-large me-1"></i>Bölümler
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-controller="Hospital" asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Hastanelere Dön
    </a>
</div>
