@model HospitalAppointment.Application.DTOs.Branch.UpdateBranchDto
@{
    ViewData["Title"] = "Şube Düzenle";
    var branchId = (Guid)ViewBag.BranchId;
    var hospitalId = (Guid)ViewBag.HospitalId;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-warning py-3">
                <h5 class="mb-0"><i class="fas fa-edit me-2"></i>Şube Düzenle</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@branchId" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Şube Adı <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label asp-for="Street" class="form-label fw-semibold">Cadde/Sokak</label>
                            <input asp-for="Street" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="District" class="form-label fw-semibold">İlçe</label>
                            <input asp-for="District" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label fw-semibold">Şehir</label>
                            <input asp-for="City" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PostalCode" class="form-label fw-semibold">Posta Kodu</label>
                            <input asp-for="PostalCode" class="form-control" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Country" class="form-label fw-semibold">Ülke</label>
                            <input asp-for="Country" class="form-control" />
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">Telefon</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">E-posta</label>
                            <input asp-for="Email" class="form-control" type="email" />
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Index" asp-route-hospitalId="@hospitalId" class="btn btn-outline-secondary">İptal</a>
                        <button type="submit" class="btn btn-warning">
                            <i class="fas fa-save me-2"></i>Güncelle
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
