@model HospitalAppointment.Application.DTOs.Branch.CreateBranchDto
@{
    ViewData["Title"] = "Yeni Şube Ekle";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header py-3" style="background:var(--primary);color:#fff">
                <h5 class="mb-0"><i class="fas fa-code-branch me-2"></i>Yeni Şube Ekle</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="HospitalId" class="form-label fw-semibold">Hastane <span class="text-danger">*</span></label>
                        <select asp-for="HospitalId" asp-items="ViewBag.Hospitals" class="form-select">
                            <option value="">— Hastane seçin —</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Şube Adı <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Merkez Şube" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Street" class="form-label fw-semibold">Cadde / Sokak / No</label>
                        <input asp-for="Street" class="form-control" placeholder="Atatürk Caddesi No:15" />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">İl <span class="text-danger">*</span></label>
                            <select id="citySelect" class="form-select">
                                <option value="">— Yükleniyor... —</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="District" class="form-label fw-semibold">İlçe <span class="text-danger">*</span></label>
                            <select asp-for="District" id="districtSelect" class="form-select" disabled>
                                <option value="">— Önce il seçin —</option>
                            </select>
                            <span asp-validation-for="District" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            @* City alanı il adıyla doldurulur *@
                            <label asp-for="City" class="form-label fw-semibold">Şehir (Otomatik)</label>
                            <input asp-for="City" id="cityText" class="form-control" readonly
                                   placeholder="İl seçince otomatik dolar" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PostalCode" class="form-label fw-semibold">Posta Kodu</label>
                            <input asp-for="PostalCode" class="form-control" placeholder="34000" maxlength="5"
                                   pattern="\d{5}" title="5 haneli posta kodu" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Country" class="form-label fw-semibold">Ülke</label>
                            <input asp-for="Country" class="form-control" value="Türkiye" readonly />
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">Telefon <span class="text-danger">*</span></label>
                            <input asp-for="PhoneNumber" class="form-control phone-mask"
                                   placeholder="+90 (5__) ___ __ __" maxlength="19" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">E-posta</label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="sube@hastane.com" />
                        </div>
                    </div>

                    <div class="d-flex gap-2 justify-content-end">
                        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Şubeyi Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/phone-mask.js"></script>
    <script>
    (function () {
        // İlleri yükle
        fetch('/Branch/GetCities')
            .then(r => r.json())
            .then(cities => {
                const sel = document.getElementById('citySelect');
                sel.innerHTML = '<option value="">— İl seçin —</option>';
                cities.forEach(c => {
                    const o = document.createElement('option');
                    o.value = c.value;
                    o.dataset.name = c.text.split(' — ')[1];
                    o.textContent = c.text;
                    sel.appendChild(o);
                });
            });

        // İl değişince ilçeleri yükle
        document.getElementById('citySelect').addEventListener('change', function () {
            const cityId = this.value;
            const cityName = this.options[this.selectedIndex]?.dataset.name ?? '';
            const distSel = document.getElementById('districtSelect');
            const cityText = document.getElementById('cityText');

            cityText.value = cityName;
            distSel.innerHTML = '<option value="">— Yükleniyor... —</option>';
            distSel.disabled = true;

            if (!cityId) {
                distSel.innerHTML = '<option value="">— Önce il seçin —</option>';
                return;
            }

            fetch(`/Branch/GetDistricts?cityId=${cityId}`)
                .then(r => r.json())
                .then(dists => {
                    distSel.innerHTML = '<option value="">— İlçe seçin —</option>';
                    dists.forEach(d => {
                        const o = document.createElement('option');
                        o.value = d.value;
                        o.textContent = d.text;
                        distSel.appendChild(o);
                    });
                    distSel.disabled = false;
                });
        });
    })();
    </script>
}
