@model HospitalAppointment.Web.Models.AppointmentViewModel
@{
    ViewData["Title"] = "Randevu Oluştur";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0"><i class="fas fa-calendar-plus me-2"></i>Yeni Randevu Oluştur</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post" id="appointmentForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <!-- Adım 1: Hastane -->
                    <div class="mb-3">
                        <label asp-for="HospitalId" class="form-label fw-semibold">
                            <span class="badge bg-primary me-1">1</span> Hastane
                        </label>
                        <select asp-for="HospitalId" asp-items="Model.Hospitals"
                                class="form-select" id="hospitalSelect">
                            <option value="">— Hastane seçin —</option>
                        </select>
                        <span asp-validation-for="HospitalId" class="text-danger small"></span>
                    </div>

                    <!-- Adım 2: Şube -->
                    <div class="mb-3">
                        <label asp-for="BranchId" class="form-label fw-semibold">
                            <span class="badge bg-primary me-1">2</span> Şube
                        </label>
                        <select asp-for="BranchId" class="form-select" id="branchSelect" disabled>
                            <option value="">— Önce hastane seçin —</option>
                        </select>
                        <span asp-validation-for="BranchId" class="text-danger small"></span>
                    </div>

                    <!-- Adım 3: Bölüm -->
                    <div class="mb-3">
                        <label asp-for="DepartmentId" class="form-label fw-semibold">
                            <span class="badge bg-primary me-1">3</span> Bölüm
                        </label>
                        <select asp-for="DepartmentId" class="form-select" id="departmentSelect" disabled>
                            <option value="">— Önce şube seçin —</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                    </div>

                    <!-- Adım 4: Doktor -->
                    <div class="mb-3">
                        <label asp-for="DoctorId" class="form-label fw-semibold">
                            <span class="badge bg-primary me-1">4</span> Doktor
                        </label>
                        <select asp-for="DoctorId" class="form-select" id="doctorSelect" disabled>
                            <option value="">— Önce bölüm seçin —</option>
                        </select>
                        <span asp-validation-for="DoctorId" class="text-danger small"></span>
                    </div>

                    <!-- Adım 5: Sağlık Hizmeti -->
                    <div class="mb-3">
                        <label asp-for="HealthcareServiceId" class="form-label fw-semibold">
                            <span class="badge bg-primary me-1">5</span> Sağlık Hizmeti
                        </label>
                        <select asp-for="HealthcareServiceId" class="form-select" id="serviceSelect" disabled>
                            <option value="">— Önce bölüm seçin —</option>
                        </select>
                        <span asp-validation-for="HealthcareServiceId" class="text-danger small"></span>
                    </div>

                    <!-- Adım 6: Tarih ve Saat -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="AppointmentDate" class="form-label fw-semibold">
                                <span class="badge bg-primary me-1">6</span> Tarih
                            </label>
                            <input asp-for="AppointmentDate" class="form-control" type="date"
                                   min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                                   max="@DateTime.Today.AddMonths(3).ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="StartTime" class="form-label fw-semibold">
                                <span class="badge bg-primary me-1">7</span> Saat
                            </label>
                            <select asp-for="StartTime" class="form-select" id="timeSelect">
                                <option value="">— Saat seçin —</option>
                                @for (int h = 8; h < 18; h++)
                                {
                                    @for (int m = 0; m < 60; m += 30)
                                    {
                                        var t = new TimeOnly(h, m);
                                        <option value="@t.ToString("HH:mm:ss")">@t.ToString("HH:mm")</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="StartTime" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Notlar -->
                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-semibold">Notlar (opsiyonel)</label>
                        <textarea asp-for="Notes" class="form-control" rows="2"
                                  placeholder="Şikayetiniz veya özel bir notunuz varsa yazabilirsiniz."></textarea>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-1"></i>İptal
                        </a>
                        <button type="submit" class="btn btn-primary" id="submitBtn" disabled>
                            <i class="fas fa-calendar-check me-2"></i>Randevu Oluştur
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    // Cascading dropdown — vanilla JS, framework gerektirmez
    (function () {
        const baseUrl = '/Appointment';

        function resetSelect(sel, placeholder) {
            sel.innerHTML = `<option value="">${placeholder}</option>`;
            sel.disabled = true;
        }

        function fillSelect(sel, items, placeholder) {
            sel.innerHTML = `<option value="">${placeholder}</option>`;
            items.forEach(item => {
                const opt = document.createElement('option');
                opt.value = item.value;
                opt.textContent = item.text;
                sel.appendChild(opt);
            });
            sel.disabled = items.length === 0;
        }

        async function fetchJson(url) {
            const r = await fetch(url);
            if (!r.ok) return [];
            return r.json();
        }

        function checkSubmitReady() {
            const allFilled = ['hospitalSelect','branchSelect','departmentSelect',
                               'doctorSelect','serviceSelect','timeSelect']
                .every(id => document.getElementById(id)?.value);
            const dateVal = document.getElementById('AppointmentDate')?.value;
            document.getElementById('submitBtn').disabled = !(allFilled && dateVal);
        }

        // Hastane değişince şubeleri yükle
        document.getElementById('hospitalSelect').addEventListener('change', async function () {
            const id = this.value;
            const branchSel = document.getElementById('branchSelect');
            const deptSel   = document.getElementById('departmentSelect');
            const docSel    = document.getElementById('doctorSelect');
            const svcSel    = document.getElementById('serviceSelect');

            resetSelect(branchSel, '— Yükleniyor... —');
            resetSelect(deptSel,   '— Önce şube seçin —');
            resetSelect(docSel,    '— Önce bölüm seçin —');
            resetSelect(svcSel,    '— Önce bölüm seçin —');

            if (!id) { resetSelect(branchSel, '— Önce hastane seçin —'); checkSubmitReady(); return; }

            const data = await fetchJson(`${baseUrl}/GetBranches?hospitalId=${id}`);
            fillSelect(branchSel, data, '— Şube seçin —');
            checkSubmitReady();
        });

        // Şube değişince bölümleri yükle
        document.getElementById('branchSelect').addEventListener('change', async function () {
            const id = this.value;
            const deptSel = document.getElementById('departmentSelect');
            const docSel  = document.getElementById('doctorSelect');
            const svcSel  = document.getElementById('serviceSelect');

            resetSelect(deptSel, '— Yükleniyor... —');
            resetSelect(docSel,  '— Önce bölüm seçin —');
            resetSelect(svcSel,  '— Önce bölüm seçin —');

            if (!id) { resetSelect(deptSel, '— Önce şube seçin —'); checkSubmitReady(); return; }

            const data = await fetchJson(`${baseUrl}/GetDepartments?branchId=${id}`);
            fillSelect(deptSel, data, '— Bölüm seçin —');
            checkSubmitReady();
        });

        // Bölüm değişince doktor ve hizmetleri yükle
        document.getElementById('departmentSelect').addEventListener('change', async function () {
            const id = this.value;
            const docSel = document.getElementById('doctorSelect');
            const svcSel = document.getElementById('serviceSelect');

            resetSelect(docSel, '— Yükleniyor... —');
            resetSelect(svcSel, '— Yükleniyor... —');

            if (!id) {
                resetSelect(docSel, '— Önce bölüm seçin —');
                resetSelect(svcSel, '— Önce bölüm seçin —');
                checkSubmitReady(); return;
            }

            const [doctors, services] = await Promise.all([
                fetchJson(`${baseUrl}/GetDoctors?departmentId=${id}`),
                fetchJson(`${baseUrl}/GetServices?departmentId=${id}`)
            ]);
            fillSelect(docSel, doctors, '— Doktor seçin —');
            fillSelect(svcSel, services, '— Hizmet seçin —');
            checkSubmitReady();
        });

        // Diğer değişiklikler
        ['doctorSelect', 'serviceSelect', 'timeSelect', 'AppointmentDate'].forEach(id => {
            document.getElementById(id)?.addEventListener('change', checkSubmitReady);
        });

        // Sayfa ilk açıldığında submit disabled
        checkSubmitReady();
    })();
    </script>
}
