@model IReadOnlyList<HospitalAppointment.Application.DTOs.Appointment.AppointmentDto>
@using HospitalAppointment.Domain.Enums
@{
    ViewData["Title"] = "Randevularım";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-700 mb-0">@ViewData["Title"]</h2>
        <small class="text-muted">@Model.Count randevu listeleniyor</small>
    </div>
    @if (User.IsInRole("Patient"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>Yeni Randevu
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-state card">
        <i class="fas fa-calendar-xmark d-block"></i>
        <p class="mb-3">Henüz randevunuz bulunmuyor.</p>
        @if (User.IsInRole("Patient"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus me-1"></i>İlk Randevunu Al
            </a>
        }
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th>Tarih / Saat</th>
                            <th>Doktor</th>
                            <th>Hizmet</th>
                            <th>Şube</th>
                            @if (User.IsInRole("Admin") || User.IsInRole("HospitalManager"))
                            {
                                <th>Hasta</th>
                            }
                            <th>Ücret</th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var apt in Model)
                        {
                            var statusClass = apt.Status switch {
                                AppointmentStatus.Pending   => "status-badge-pending",
                                AppointmentStatus.Confirmed => "status-badge-confirmed",
                                AppointmentStatus.Rejected  => "status-badge-rejected",
                                AppointmentStatus.Cancelled => "status-badge-cancelled",
                                AppointmentStatus.Completed => "status-badge-completed",
                                AppointmentStatus.NoShow    => "status-badge-noshow",
                                _ => "bg-secondary text-white"
                            };
                            <tr>
                                <td>
                                    <div class="fw-600" style="font-size:.9rem">
                                        @apt.AppointmentDate.ToString("dd MMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                                    </div>
                                    <div class="text-muted" style="font-size:.8rem">
                                        @apt.StartTime.ToString("HH:mm") – @apt.EndTime.ToString("HH:mm")
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-600" style="font-size:.9rem">Dr. @apt.DoctorName</div>
                                    <div class="text-muted" style="font-size:.78rem">@apt.DoctorSpecialization</div>
                                </td>
                                <td style="font-size:.88rem">@apt.ServiceName</td>
                                <td style="font-size:.88rem">@apt.BranchName</td>
                                @if (User.IsInRole("Admin") || User.IsInRole("HospitalManager"))
                                {
                                    <td style="font-size:.88rem">@apt.PatientName</td>
                                }
                                <td style="font-size:.88rem;white-space:nowrap">
                                    @apt.Price.ToString("N0") ₺
                                </td>
                                <td>
                                    <span class="badge @statusClass">@apt.StatusDisplay</span>
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@apt.Id"
                                           class="btn btn-sm btn-outline-secondary" title="Detay">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (apt.Status == AppointmentStatus.Pending || apt.Status == AppointmentStatus.Confirmed)
                                        {
                                            <form asp-action="Cancel" asp-route-id="@apt.Id" method="post"
                                                  onsubmit="return confirm('Randevuyu iptal etmek istediğinizden emin misiniz?')">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="İptal">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </form>
                                        }
                                        @if ((User.IsInRole("Doctor") || User.IsInRole("Admin")) && apt.Status == AppointmentStatus.Pending)
                                        {
                                            <form asp-action="Confirm" asp-route-id="@apt.Id" method="post">
                                                <button type="submit" class="btn btn-sm btn-success" title="Onayla">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
