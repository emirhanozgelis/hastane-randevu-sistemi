<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — MediRandevu</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

<nav class="navbar navbar-expand-lg navbar-dark">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
            <span class="brand-icon"><i class="fas fa-heartbeat"></i></span>
            MediRandevu
        </a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto ms-3 gap-1">

                @if (User.IsInRole("Admin") || User.IsInRole("HospitalManager"))
                {
                    @* Admin için tüm yönetim linkleri doğrudan görünür *@
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Index">
                            <i class="fas fa-tachometer-alt me-1"></i>Panel
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="fas fa-hospital me-1"></i>Hastane
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Hospital" asp-action="Index">
                                <i class="fas fa-hospital me-2 text-muted"></i>Hastaneler</a></li>
                            <li><a class="dropdown-item" asp-controller="Branch" asp-action="Index">
                                <i class="fas fa-code-branch me-2 text-muted"></i>Şubeler</a></li>
                            <li><a class="dropdown-item" asp-controller="Department" asp-action="Index">
                                <i class="fas fa-th-large me-2 text-muted"></i>Bölümler</a></li>
                            <li><a class="dropdown-item" asp-controller="HealthcareService" asp-action="Index">
                                <i class="fas fa-stethoscope me-2 text-muted"></i>Sağlık Hizmetleri</a></li>
                        </ul>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Doctor" asp-action="Index">
                            <i class="fas fa-user-md me-1"></i>Doktorlar
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Appointment" asp-action="Index">
                            <i class="fas fa-calendar-alt me-1"></i>Randevular
                        </a>
                    </li>
                }
                else if (User.IsInRole("Doctor"))
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Doctor" asp-action="Index">
                            <i class="fas fa-user-md me-1"></i>Doktorlar
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Appointment" asp-action="Index">
                            <i class="fas fa-calendar-check me-1"></i>Randevularım
                        </a>
                    </li>
                }
                else
                {
                    @* Hasta veya anonim kullanıcı *@
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Doctor" asp-action="Index">
                            <i class="fas fa-user-md me-1"></i>Doktorlar
                        </a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Appointment" asp-action="Index">
                                <i class="fas fa-calendar-check me-1"></i>Randevularım
                            </a>
                        </li>
                    }
                }

            </ul>
            <ul class="navbar-nav align-items-center gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Patient"))
                    {
                        <li class="nav-item">
                            <a asp-controller="Appointment" asp-action="Create"
                               class="btn btn-sm btn-outline-light rounded-pill px-3">
                                <i class="fas fa-plus me-1"></i>Randevu Al
                            </a>
                        </li>
                    }
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" data-bs-toggle="dropdown">
                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-white text-primary fw-bold"
                                  style="width:30px;height:30px;font-size:.8rem">
                                @(User.Identity.Name?.Substring(0,1).ToUpper() ?? "?")
                            </span>
                            <span class="d-none d-md-inline" style="font-size:.88rem">@User.Identity.Name</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger">
                                        <i class="fas fa-sign-out-alt me-2"></i>Çıkış Yap
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Account" asp-action="Login">Giriş</a>
                    </li>
                    <li class="nav-item">
                        <a class="btn btn-sm btn-outline-light rounded-pill px-3"
                           asp-controller="Account" asp-action="Register">Kayıt Ol</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<main>
    <div class="container py-4">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="fas fa-check-circle flex-shrink-0"></i>
                <span>@TempData["Success"]</span>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-4" role="alert">
                <i class="fas fa-exclamation-circle flex-shrink-0"></i>
                <span>@TempData["Error"]</span>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </div>
</main>

<footer>
    <div class="container d-flex justify-content-between align-items-center">
        <span><i class="fas fa-heartbeat text-danger me-1"></i> MediRandevu &copy; 2026</span>
        <span>Güvenli Sağlık Randevu Sistemi</span>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
