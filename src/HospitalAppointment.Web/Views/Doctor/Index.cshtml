@model IReadOnlyList<HospitalAppointment.Application.DTOs.Doctor.DoctorDto>
@{
    ViewData["Title"] = "Doktorlar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-700 mb-0">Doktorlarımız</h2>
        <small class="text-muted">@Model.Count uzman hekimle hizmetinizdeyiz</small>
    </div>
    @if (User.IsInRole("Admin") || User.IsInRole("HospitalManager"))
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>Doktor Ekle
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="fas fa-user-md d-block"></i>
        <p>Kayıtlı doktor bulunamadı.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var doctor in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-start gap-3">
                            <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                                 style="width:52px;height:52px;background:var(--primary-lt);">
                                <i class="fas fa-user-md" style="color:var(--primary)"></i>
                            </div>
                            <div class="flex-grow-1 min-width-0">
                                <h6 class="fw-700 mb-1 text-truncate">Dr. @doctor.FullName</h6>
                                <span class="badge mb-2" style="background:var(--accent-lt);color:var(--accent);font-size:.75rem">
                                    @doctor.Specialization
                                </span>
                                <div class="text-muted" style="font-size:.82rem">
                                    <div><i class="fas fa-hospital me-1 opacity-50"></i>@doctor.BranchName</div>
                                    <div><i class="fas fa-th-large me-1 opacity-50"></i>@doctor.DepartmentName</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-top d-flex gap-2 p-3">
                        <a asp-action="Availability" asp-route-id="@doctor.Id"
                           class="btn btn-sm btn-outline-secondary flex-grow-1">
                            <i class="fas fa-clock me-1"></i>Takvim
                        </a>
                        @if (User.IsInRole("Patient"))
                        {
                            <a asp-controller="Appointment" asp-action="Create"
                               asp-route-doctorId="@doctor.Id"
                               class="btn btn-sm btn-primary flex-grow-1">
                                <i class="fas fa-calendar-plus me-1"></i>Randevu Al
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
