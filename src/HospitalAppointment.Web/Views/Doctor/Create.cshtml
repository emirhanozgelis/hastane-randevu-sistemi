@model HospitalAppointment.Application.DTOs.Doctor.CreateDoctorDto
@{
    ViewData["Title"] = "Yeni Doktor Ekle";
}

<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0"><i class="fas fa-user-md me-2"></i>Yeni Doktor Ekle</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label fw-semibold">Ad</label>
                            <input asp-for="FirstName" class="form-control" placeholder="Adı" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label fw-semibold">Soyad</label>
                            <input asp-for="LastName" class="form-control" placeholder="Soyadı" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold">E-posta</label>
                            <input asp-for="Email" class="form-control" type="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">Telefon</label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="05xxxxxxxxx" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold">Doğum Tarihi</label>
                            <input asp-for="DateOfBirth" class="form-control" type="date" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label fw-semibold">Cinsiyet</label>
                            <select asp-for="Gender" class="form-select">
                                <option value="0">Belirtilmedi</option>
                                <option value="1">Erkek</option>
                                <option value="2">Kadın</option>
                                <option value="3">Diğer</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EmployeeNumber" class="form-label fw-semibold">Personel No</label>
                            <input asp-for="EmployeeNumber" class="form-control" placeholder="EMP-001" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="HireDate" class="form-label fw-semibold">İşe Başlama Tarihi</label>
                            <input asp-for="HireDate" class="form-control" type="date" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BranchId" class="form-label fw-semibold">Şube</label>
                            <select asp-for="BranchId" asp-items="ViewBag.Branches" class="form-select">
                                <option value="">— Şube seçin —</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DepartmentId" class="form-label fw-semibold">Bölüm</label>
                            <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-select">
                                <option value="">— Bölüm seçin —</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Specialization" class="form-label fw-semibold">Uzmanlık</label>
                            <input asp-for="Specialization" class="form-control" placeholder="Kardiyoloji" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LicenseNumber" class="form-label fw-semibold">Lisans No</label>
                            <input asp-for="LicenseNumber" class="form-control" placeholder="LIC-00001" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold">Şifre</label>
                            <input asp-for="Password" class="form-control" type="password" placeholder="En az 6 karakter" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Biography" class="form-label fw-semibold">Biyografi (opsiyonel)</label>
                            <textarea asp-for="Biography" class="form-control" rows="3"
                                      placeholder="Doktor hakkında kısa bilgi..."></textarea>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
