@model HospitalAppointment.Web.Models.CreateDoctorViewModel
@{
    ViewData["Title"] = "Yeni Doktor Ekle";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-success text-white py-3">
                <h4 class="mb-0"><i class="fas fa-user-md me-2"></i>Yeni Doktor Ekle</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label fw-semibold">Ad</label>
                            <input asp-for="FirstName" class="form-control" placeholder="Doktorun adı" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label fw-semibold">Soyad</label>
                            <input asp-for="LastName" class="form-control" placeholder="Doktorun soyadı" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-7">
                            <label asp-for="Email" class="form-label fw-semibold">E-posta</label>
                            <input asp-for="Email" class="form-control" placeholder="doktor@hastane.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">Telefon</label>
                            <input asp-for="PhoneNumber" class="form-control phone-mask" placeholder="+90 (5__) ___ __ __" maxlength="19" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold">Doğum Tarihi</label>
                            <input asp-for="DateOfBirth" class="form-control" type="date" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Gender" class="form-label fw-semibold">Cinsiyet</label>
                            <select asp-for="Gender" class="form-select">
                                <option value="0">Belirtilmedi</option>
                                <option value="1">Erkek</option>
                                <option value="2">Kadın</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="HireDate" class="form-label fw-semibold">İşe Giriş Tarihi</label>
                            <input asp-for="HireDate" class="form-control" type="date" />
                            <span asp-validation-for="HireDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EmployeeNumber" class="form-label fw-semibold">Personel Numarası</label>
                            <input asp-for="EmployeeNumber" class="form-control" placeholder="DOC001" />
                            <span asp-validation-for="EmployeeNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LicenseNumber" class="form-label fw-semibold">Lisans Numarası</label>
                            <input asp-for="LicenseNumber" class="form-control" placeholder="LIC12345" />
                            <span asp-validation-for="LicenseNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12">
                            <label asp-for="Specialization" class="form-label fw-semibold">Uzmanlık Alanı</label>
                            <select asp-for="Specialization" class="form-select">
                                <option value="">— Uzmanlık seçin —</option>
                                @foreach (var spec in HospitalAppointment.Web.Models.ValidationPatterns.MedicalSpecializations)
                                {
                                    <option value="@spec">@spec</option>
                                }
                            </select>
                            <span asp-validation-for="Specialization" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BranchId" class="form-label fw-semibold">Şube</label>
                            <select asp-for="BranchId" asp-items="Model.Branches" class="form-select"
                                    id="branchSelectDoctor">
                                <option value="">— Şube seçin —</option>
                            </select>
                            <span asp-validation-for="BranchId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DepartmentId" class="form-label fw-semibold">Bölüm</label>
                            <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select"
                                    id="departmentSelectDoctor">
                                <option value="">— Önce şube seçin —</option>
                            </select>
                            <span asp-validation-for="DepartmentId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label fw-semibold">Sistem Şifresi</label>
                            <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Biography" class="form-label fw-semibold">Biyografi (opsiyonel)</label>
                            <textarea asp-for="Biography" class="form-control" rows="2"
                                      placeholder="Doktor hakkında kısa bilgi..."></textarea>
                        </div>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save me-2"></i>Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/phone-mask.js"></script>
    <script>
    document.getElementById('branchSelectDoctor')?.addEventListener('change', async function () {
        const branchId = this.value;
        const deptSel = document.getElementById('departmentSelectDoctor');
        deptSel.innerHTML = '<option value="">— Yükleniyor... —</option>';
        if (!branchId) { deptSel.innerHTML = '<option value="">— Önce şube seçin —</option>'; return; }
        const data = await fetch(`/Appointment/GetDepartments?branchId=${branchId}`).then(r => r.json());
        deptSel.innerHTML = '<option value="">— Bölüm seçin —</option>';
        data.forEach(d => {
            const o = document.createElement('option');
            o.value = d.value; o.textContent = d.text;
            deptSel.appendChild(o);
        });
    });
    </script>
}
