@model IReadOnlyList<HospitalAppointment.Application.DTOs.Doctor.DoctorAvailabilityDto>
@{
    ViewData["Title"] = "Doktor Müsaitlik Takvimi";
    var doctor = ViewBag.Doctor as HospitalAppointment.Application.DTOs.Doctor.DoctorDto;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>
        <i class="fas fa-calendar-alt me-2 text-primary"></i>
        @doctor?.FullName — Müsaitlik Takvimi
    </h2>
    @if (User.IsInRole("Admin") || User.IsInRole("Doctor"))
    {
        <a asp-action="AddAvailability" asp-route-id="@doctor?.Id" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>Müsaitlik Ekle
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>Bu doktor için henüz müsaitlik kaydı oluşturulmamış.
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-primary">
                        <tr>
                            <th>Gün / Tarih</th>
                            <th>Başlangıç</th>
                            <th>Bitiş</th>
                            <th>Tür</th>
                            <th>Durum</th>
                            <th>Notlar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var slot in Model)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @if (slot.IsSpecificDate)
                                    {
                                        <span>@slot.Date.ToString("dd.MM.yyyy")</span>
                                    }
                                    else
                                    {
                                        @switch (slot.DayOfWeek)
                                        {
                                            case DayOfWeek.Monday: <span>Pazartesi</span> break;
                                            case DayOfWeek.Tuesday: <span>Salı</span> break;
                                            case DayOfWeek.Wednesday: <span>Çarşamba</span> break;
                                            case DayOfWeek.Thursday: <span>Perşembe</span> break;
                                            case DayOfWeek.Friday: <span>Cuma</span> break;
                                            case DayOfWeek.Saturday: <span>Cumartesi</span> break;
                                            case DayOfWeek.Sunday: <span>Pazar</span> break;
                                        }
                                    }
                                </td>
                                <td>@slot.StartTime.ToString("HH:mm")</td>
                                <td>@slot.EndTime.ToString("HH:mm")</td>
                                <td>
                                    @if (slot.IsSpecificDate)
                                    {
                                        <span class="badge bg-info">Özel Tarih</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Haftalık</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(slot.IsAvailable ? "bg-success" : "bg-danger")">
                                        @(slot.IsAvailable ? "Müsait" : "Meşgul")
                                    </span>
                                </td>
                                <td><small class="text-muted">@(slot.Notes ?? "—")</small></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-action="Details" asp-route-id="@doctor?.Id" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Doktor Detayına Dön
    </a>
</div>
