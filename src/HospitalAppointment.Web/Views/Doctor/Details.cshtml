@model HospitalAppointment.Application.DTOs.Doctor.DoctorDto
@{
    ViewData["Title"] = "Doktor Detayı";
    var availability = ViewBag.Availability as IReadOnlyList<HospitalAppointment.Application.DTOs.Doctor.DoctorAvailabilityDto>
        ?? new List<HospitalAppointment.Application.DTOs.Doctor.DoctorAvailabilityDto>();
}

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body p-4">
                <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-3"
                     style="width:90px;height:90px;font-size:2.5rem">
                    <i class="fas fa-user-md"></i>
                </div>
                <h4 class="fw-bold">@Model.FullName</h4>
                <p class="text-muted"><i class="fas fa-stethoscope me-1"></i>@Model.Specialization</p>
                <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger") mb-3">
                    @(Model.IsActive ? "Aktif" : "Pasif")
                </span>
                <hr />
                <div class="text-start small">
                    <p class="mb-1"><strong><i class="fas fa-hospital me-1"></i>Şube:</strong> @Model.BranchName</p>
                    <p class="mb-1"><strong><i class="fas fa-th-large me-1"></i>Bölüm:</strong> @Model.DepartmentName</p>
                    <p class="mb-1"><strong><i class="fas fa-id-badge me-1"></i>Lisans No:</strong> @Model.LicenseNumber</p>
                    <p class="mb-1"><strong><i class="fas fa-envelope me-1"></i>E-posta:</strong> @Model.Email</p>
                    <p class="mb-0"><strong><i class="fas fa-phone me-1"></i>Telefon:</strong> @Model.PhoneNumber</p>
                </div>
            </div>
            @if (User.IsInRole("Patient"))
            {
                <div class="card-footer bg-transparent border-0 pb-3">
                    <a asp-controller="Appointment" asp-action="Create" class="btn btn-primary w-100">
                        <i class="fas fa-calendar-plus me-2"></i>Randevu Al
                    </a>
                </div>
            }
        </div>
    </div>

    <div class="col-md-8">
        @if (!string.IsNullOrEmpty(Model.Biography))
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-light fw-semibold">
                    <i class="fas fa-info-circle me-2 text-primary"></i>Hakkında
                </div>
                <div class="card-body">
                    <p class="mb-0">@Model.Biography</p>
                </div>
            </div>
        }

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-light fw-semibold d-flex justify-content-between align-items-center">
                <span><i class="fas fa-calendar-alt me-2 text-primary"></i>Müsaitlik Takvimi</span>
                @if (User.IsInRole("Admin") || User.IsInRole("Doctor"))
                {
                    <a asp-action="AddAvailability" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">
                        <i class="fas fa-plus me-1"></i>Ekle
                    </a>
                }
            </div>
            <div class="card-body">
                @if (!availability.Any())
                {
                    <div class="alert alert-info mb-0">
                        <i class="fas fa-info-circle me-2"></i>Müsaitlik kaydı bulunmuyor.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Gün / Tarih</th>
                                    <th>Başlangıç</th>
                                    <th>Bitiş</th>
                                    <th>Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var slot in availability)
                                {
                                    <tr>
                                        <td>
                                            @if (slot.IsSpecificDate)
                                            {
                                                <span>@slot.Date.ToString("dd.MM.yyyy")</span>
                                            }
                                            else
                                            {
                                                <span>@slot.DayOfWeek</span>
                                            }
                                        </td>
                                        <td>@slot.StartTime.ToString("HH:mm")</td>
                                        <td>@slot.EndTime.ToString("HH:mm")</td>
                                        <td>
                                            <span class="badge @(slot.IsAvailable ? "bg-success" : "bg-danger")">
                                                @(slot.IsAvailable ? "Müsait" : "Meşgul")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Geri Dön
    </a>
</div>
