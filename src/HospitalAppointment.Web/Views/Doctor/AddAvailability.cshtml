@model HospitalAppointment.Application.DTOs.Doctor.CreateDoctorAvailabilityDto
@{
    ViewData["Title"] = "Müsaitlik Ekle";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0">
                    <i class="fas fa-calendar-plus me-2"></i>Müsaitlik Ekle — @ViewBag.DoctorName
                </h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="AddAvailability" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input asp-for="DoctorId" type="hidden" />

                    <!-- Tür Seçimi -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Müsaitlik Türü</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="availabilityType"
                                   id="typeWeekly" value="weekly" checked
                                   onclick="toggleAvailabilityType('weekly')" />
                            <label class="form-check-label" for="typeWeekly">Haftalık (Hergün tekrar)</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="availabilityType"
                                   id="typeSpecific" value="specific"
                                   onclick="toggleAvailabilityType('specific')" />
                            <label class="form-check-label" for="typeSpecific">Özel Tarih</label>
                        </div>
                    </div>

                    <!-- Haftalık Gün -->
                    <div class="mb-3" id="weeklySection">
                        <label asp-for="DayOfWeek" class="form-label fw-semibold">Gün</label>
                        <select asp-for="DayOfWeek" class="form-select">
                            <option value="">— Gün seçin —</option>
                            <option value="1">Pazartesi</option>
                            <option value="2">Salı</option>
                            <option value="3">Çarşamba</option>
                            <option value="4">Perşembe</option>
                            <option value="5">Cuma</option>
                            <option value="6">Cumartesi</option>
                            <option value="0">Pazar</option>
                        </select>
                    </div>

                    <!-- Özel Tarih -->
                    <div class="mb-3 d-none" id="specificSection">
                        <label asp-for="SpecificDate" class="form-label fw-semibold">Tarih</label>
                        <input asp-for="SpecificDate" class="form-control" type="date"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>

                    <!-- Saat Aralığı -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="StartTime" class="form-label fw-semibold">Başlangıç Saati</label>
                            <input asp-for="StartTime" class="form-control" type="time" />
                            <span asp-validation-for="StartTime" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndTime" class="form-label fw-semibold">Bitiş Saati</label>
                            <input asp-for="EndTime" class="form-control" type="time" />
                            <span asp-validation-for="EndTime" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Durum -->
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsAvailable" class="form-check-input" type="checkbox" role="switch" checked />
                            <label asp-for="IsAvailable" class="form-check-label fw-semibold">Müsait</label>
                        </div>
                    </div>

                    <!-- Notlar -->
                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label fw-semibold">Notlar (opsiyonel)</label>
                        <input asp-for="Notes" class="form-control" placeholder="Opsiyonel açıklama..." />
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Availability" asp-route-id="@Model.DoctorId"
                           class="btn btn-outline-secondary">İptal</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleAvailabilityType(type) {
            const weekly = document.getElementById('weeklySection');
            const specific = document.getElementById('specificSection');
            if (type === 'weekly') {
                weekly.classList.remove('d-none');
                specific.classList.add('d-none');
            } else {
                weekly.classList.add('d-none');
                specific.classList.remove('d-none');
            }
        }
    </script>
}
