@model HospitalAppointment.Application.DTOs.Hospital.CreateHospitalDto
@{
    ViewData["Title"] = "Yeni Hastane Ekle";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0"><i class="fas fa-hospital me-2"></i>Yeni Hastane Ekle</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Hastane Adı <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Merkezi Hastane" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-8">
                            <label asp-for="Street" class="form-label fw-semibold">Cadde/Sokak <span class="text-danger">*</span></label>
                            <input asp-for="Street" class="form-control" placeholder="Bağdat Caddesi No:1" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="District" class="form-label fw-semibold">İlçe <span class="text-danger">*</span></label>
                            <input asp-for="District" class="form-control" placeholder="Kadıköy" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label fw-semibold">Şehir <span class="text-danger">*</span></label>
                            <input asp-for="City" class="form-control" placeholder="İstanbul" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PostalCode" class="form-label fw-semibold">Posta Kodu <span class="text-danger">*</span></label>
                            <input asp-for="PostalCode" class="form-control" placeholder="34710" />
                        </div>
                        <div class="col-md-3">
                            <label asp-for="Country" class="form-label fw-semibold">Ülke</label>
                            <input asp-for="Country" class="form-control" value="Türkiye" />
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label asp-for="TaxNumber" class="form-label fw-semibold">Vergi No</label>
                            <input asp-for="TaxNumber" class="form-control" placeholder="1234567890" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="ContactEmail" class="form-label fw-semibold">E-posta</label>
                            <input asp-for="ContactEmail" class="form-control" type="email" placeholder="info@hastane.com" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Website" class="form-label fw-semibold">Web Sitesi</label>
                            <input asp-for="Website" class="form-control" placeholder="https://hastane.com" />
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
