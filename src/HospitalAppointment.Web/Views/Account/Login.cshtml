@model HospitalAppointment.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-4 col-lg-4">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
                 style="width:60px;height:60px;background:var(--primary-lt);">
                <i class="fas fa-heartbeat fa-xl" style="color:var(--primary)"></i>
            </div>
            <h4 class="fw-700">Hesabınıza Giriş Yapın</h4>
            <p class="text-muted" style="font-size:.88rem">Randevularınızı görüntüleyin ve yönetin</p>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Login" method="post">
                    <input asp-for="ReturnUrl" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">E-posta</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="fas fa-envelope text-muted"></i></span>
                            <input asp-for="Email" class="form-control border-start-0"
                                   placeholder="ornek@mail.com" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-semibold">Şifre</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white"><i class="fas fa-lock text-muted"></i></span>
                            <input asp-for="Password" class="form-control border-start-0"
                                   placeholder="••••••••" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">
                        Giriş Yap <i class="fas fa-arrow-right ms-1"></i>
                    </button>
                </form>

                <hr class="my-3">
                <p class="text-center text-muted mb-1" style="font-size:.88rem">
                    Hesabınız yok mu?
                    <a asp-action="Register" class="text-primary fw-600">Kayıt Ol</a>
                </p>
                <p class="text-center text-muted" style="font-size:.8rem">
                    Demo: <code>admin@hospital.com</code> / <code>Admin123!</code>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
