@model HospitalAppointment.Application.DTOs.HealthcareService.CreateHealthcareServiceDto
@{
    ViewData["Title"] = "Yeni Sağlık Hizmeti";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow border-0">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0"><i class="fas fa-stethoscope me-2"></i>Yeni Sağlık Hizmeti</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="DepartmentId" class="form-label fw-semibold">Bölüm <span class="text-danger">*</span></label>
                        <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-select">
                            <option value="">— Bölüm seçin —</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Hizmet Adı <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Kardiyoloji Muayenesi" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="DurationMinutes" class="form-label fw-semibold">Süre (dakika) <span class="text-danger">*</span></label>
                            <input asp-for="DurationMinutes" class="form-control" type="number" min="5" step="5" placeholder="30" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Price" class="form-label fw-semibold">Ücret <span class="text-danger">*</span></label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" placeholder="500.00" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Currency" class="form-label fw-semibold">Para Birimi</label>
                            <select asp-for="Currency" class="form-select">
                                <option value="TRY">TRY</option>
                                <option value="USD">USD</option>
                                <option value="EUR">EUR</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-semibold">Açıklama</label>
                        <textarea asp-for="Description" class="form-control" rows="3"
                                  placeholder="Hizmet hakkında açıklama..."></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
