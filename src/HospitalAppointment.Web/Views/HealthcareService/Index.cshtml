@model IReadOnlyList<HospitalAppointment.Application.DTOs.HealthcareService.HealthcareServiceDto>
@{
    ViewData["Title"] = "Sağlık Hizmetleri";
    var departmentId = (Guid)ViewBag.DepartmentId;
    var departmentName = (string)(ViewBag.DepartmentName ?? "");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2><i class="fas fa-stethoscope me-2 text-primary"></i>Sağlık Hizmetleri</h2>
        <small class="text-muted">@departmentName</small>
    </div>
    <a asp-action="Create" asp-route-departmentId="@departmentId" class="btn btn-primary">
        <i class="fas fa-plus me-2"></i>Yeni Hizmet
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle me-2"></i>Bu bölüme ait sağlık hizmeti bulunamadı.
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-primary">
                        <tr>
                            <th>Hizmet Adı</th>
                            <th>Süre (dk)</th>
                            <th>Ücret</th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var svc in Model)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@svc.Name</div>
                                    @if (!string.IsNullOrEmpty(svc.Description))
                                    {
                                        <small class="text-muted">@svc.Description</small>
                                    }
                                </td>
                                <td>@svc.DurationMinutes dk</td>
                                <td>@svc.Price.ToString("N2") @svc.Currency</td>
                                <td>
                                    <span class="badge @(svc.IsActive ? "bg-success" : "bg-danger")">
                                        @(svc.IsActive ? "Aktif" : "Pasif")
                                    </span>
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@svc.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-controller="Department" asp-action="Index" asp-route-branchId="@Model.FirstOrDefault()?.DepartmentId"
       class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Bölümlere Dön
    </a>
</div>
